# Nextcloud integration_openai -> City llama.cpp (Frank / TRL4)
# Apply with: ops/bootstrap/apply-nc-openai-llm.sh
# Never commit real API keys if you set a non-dummy value.

NC_OPENAI_URL=http://col-llama-cpp:8081
NC_OPENAI_MODEL=/models/Bonsai-4B-Q1_0.gguf
NC_OPENAI_SERVICE_NAME='Bonsai LLM (TRL4)'
# Dummy key is fine for local llama-server (auth usually disabled)
NC_OPENAI_API_KEY=no-key-needed
NC_OPENAI_CHAT_ENDPOINT_ENABLED=1
# Keep generation bounded for 4B + 16k ctx on 1050 Ti
NC_OPENAI_MAX_TOKENS=512
