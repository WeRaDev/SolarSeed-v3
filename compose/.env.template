# Copy this file to compose/.env and replace all CHANGE_ME_* values.
# Never commit real secrets.

# General
TZ=UTC

# === PostgreSQL (House) ===
POSTGRES_DB=cityoflight
POSTGRES_USER=citydb
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# === Rundeck (Factory) ===
RUNDECK_ADMIN_PASSWORD=CHANGE_ME_RUNDECK_ADMIN_PASSWORD
RUNDECK_GRAILS_URL=http://localhost:4440

# === Nextcloud AIO (Fortress) ===
NEXTCLOUD_DATADIR=/data/nextcloud
APACHE_PORT=8080
APACHE_IP_BINDING=0.0.0.0
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_NEXTCLOUD_ADMIN_PASSWORD

# === Prometheus / Alertmanager (Library) ===
PROMETHEUS_RETENTION=30d
ALERTMANAGER_WEBHOOK_URL=http://spirit:9105/webhook/prometheus

# === Spirit (Agent/Brain) ===
SPIRIT_NAME=city_spirit_wera_ss_pt_sn_1
SPIRIT_PORT=9105
SPIRIT_HEARTBEAT_SECONDS=300
SPIRIT_LOG_LEVEL=info
SPIRIT_LLM_ENABLED=false
SPIRIT_LLM_ENDPOINT=http://llama-cpp:8081
SPIRIT_LLM_TIMEOUT=60
SPIRIT_LLM_MAX_TOKENS=512
# Comma-separated HTTP probes for services without Prometheus metrics
# Format: name=url,name=url
SPIRIT_HTTP_PROBES=nextcloud=http://filantropia-nextcloud:80,ml=http://filantropia-ml:8501/health

# === OpenFang (Persona Layer) ===
OPENFANG_REF=v0.3.11
OPENFANG_LOG_LEVEL=info
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=

# === llama.cpp (University / NC Assistant) ===
# Frank verified (driver 550 / GTX 1050 Ti): local CUDA 12.4.1 sm_61 image — NOT rolling :server-cuda
LLAMA_IMAGE=local/llama.cpp:server-cuda-12.4.1-sm61
LLAMA_CONTAINER_NAME=col-llama-cpp
LLAMA_MODELS_DIR=/data/models
LLAMA_MODEL=/models/Bonsai-4B-Q1_0.gguf
LLAMA_THREADS=4
LLAMA_CTX_SIZE=16384
LLAMA_PARALLEL=1
LLAMA_N_GPU_LAYERS=999
LLAMA_MEM_LIMIT=4G
LLAMA_MEM_RESERVE=2G
LLAMA_HOST_BIND=127.0.0.1
# Nextcloud integration_openai (apply via ops/bootstrap/apply-nc-openai-llm.sh)
NC_OPENAI_URL=http://col-llama-cpp:8081
NC_OPENAI_MODEL=/models/Bonsai-4B-Q1_0.gguf
NC_OPENAI_SERVICE_NAME=Bonsai LLM (TRL4)
